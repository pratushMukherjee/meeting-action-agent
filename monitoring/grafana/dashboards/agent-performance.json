{
  "dashboard": {
    "title": "Meeting Action Agent Performance",
    "uid": "meeting-agent-perf",
    "panels": [
      {
        "title": "Task Success Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(agent_task_total{status='success'}[5m])) / sum(rate(agent_task_total[5m])) * 100"
          }
        ],
        "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}
      },
      {
        "title": "Active Sessions",
        "type": "gauge",
        "targets": [
          {
            "expr": "agent_active_sessions"
          }
        ],
        "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0}
      },
      {
        "title": "Task Duration (p95)",
        "type": "stat",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(agent_task_duration_seconds_bucket[5m]))"
          }
        ],
        "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0}
      },
      {
        "title": "Tool Errors Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(agent_tool_errors_total[5m]))"
          }
        ],
        "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0}
      },
      {
        "title": "Tool Calls by Type",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(agent_tool_calls_total[5m])) by (tool)",
            "legendFormat": "{{tool}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}
      },
      {
        "title": "LLM Token Usage",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(agent_llm_tokens_total[5m])) by (type)",
            "legendFormat": "{{type}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}
      },
      {
        "title": "LLM Latency (p50/p95/p99)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(agent_llm_latency_seconds_bucket[5m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(agent_llm_latency_seconds_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(agent_llm_latency_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14}
      },
      {
        "title": "Guardrail Violations",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(agent_guardrail_violations_total[5m])) by (guardrail_type)",
            "legendFormat": "{{guardrail_type}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14}
      }
    ]
  }
}
